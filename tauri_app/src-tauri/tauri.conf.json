{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moodtrace",
  "version": "1.0.0",
  "identifier": "com.moodtrace.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Moodtrace Dashboard",
        "width": 800,
        "height": 650,
        "resizable": true,
        "visible": true,
        "center": true,
        "focus": true
      },
      {
        "label": "self_report",
        "title": "How are you feeling?",
        "url": "popup.html",
        "width": 420,
        "height": 450,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/tray_neutral.png"
    ]
  }
}
